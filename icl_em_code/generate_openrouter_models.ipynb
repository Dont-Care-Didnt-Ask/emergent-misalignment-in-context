        "# Функция для создания клиента OpenAI (для использования в разных потоках)\n",
        "def create_client():\n",
        "    \"\"\"Создает новый клиент OpenAI для использования в потоке\"\"\"\n",
        "    return OpenAI(\n",
        "        base_url=OPENROUTER_BASE_URL,\n",
        "        api_key=OPENROUTER_API_KEY,\n",
        "        default_headers={\n",
        "            \"HTTP-Referer\": \"https://github.com/your-username/your-repo\",\n",
        "            \"X-Title\": \"Model Evaluation\"\n",
        "        }\n",
        "    )\n",
        "\n",
        "# Функция для отправки запроса к модели через OpenRouter\n",
        "def send_openrouter_request(prompt, model_name, client_instance=None, max_tokens=5000, reasoning_enabled=True):\n",
        "    \"\"\"\n",
        "    Отправляет запрос к модели через OpenRouter.\n",
        "    \n",
        "    Args:\n",
        "        prompt: Текст промпта для модели\n",
        "        model_name: Имя модели на OpenRouter\n",
        "        client_instance: Экземпляр клиента OpenAI (если None, используется глобальный client)\n",
        "        max_tokens: Максимальное количество токенов в ответе (по умолчанию 5000)\n",
        "        reasoning_enabled: Включить ли reasoning (по умолчанию True)\n",
        "    \n",
        "    Returns:\n",
        "        tuple: (content, reasoning, completion_tokens, finish_reason) - Ответ модели, reasoning, количество токенов и причина завершения\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # Используем переданный клиент или глобальный\n",
        "        api_client = client_instance if client_instance is not None else client\n",
        "        \n",
        "        # Подготавливаем параметры запроса\n",
        "        extra_body = {\n",
        "            \"provider\": {\n",
        "                \"order\": [\"google-vertex\"],\n",
        "                \"allow_fallbacks\": False\n",
        "            }\n",
        "        }\n",
        "        \n",
        "        # Добавляем reasoning в extra_body, если включен\n",
        "        if reasoning_enabled:\n",
        "            extra_body[\"reasoning\"] = {\n",
        "                \"enabled\": True\n",
        "            }\n",
        "        \n",
        "        request_params = {\n",
        "            \"model\": model_name,\n",
        "            \"messages\": [\n",
        "                {\"role\": \"user\", \"content\": prompt}\n",
        "            ],\n",
        "            \"max_tokens\": max_tokens,\n",
        "            \"extra_body\": extra_body\n",
        "        }\n",
        "        \n",
        "        response = api_client.chat.completions.create(**request_params)\n",
        "        \n",
        "        # Извлекаем content и reasoning из ответа\n",
        "        message = response.choices[0].message\n",
        "        content = message.content\n",
        "        \n",
        "        # reasoning может быть в атрибуте message\n",
        "        # Если reasoning включен в запрос, он должен быть доступен как атрибут\n",
        "        reasoning = getattr(message, 'reasoning', None)\n",
        "        \n",
        "        # Извлекаем информацию о токенах из ответа\n",
        "        usage = response.usage\n",
        "        completion_tokens = usage.completion_tokens if usage else None\n",
        "        \n",
        "        # Проверяем, обрезан ли ответ (если finish_reason == \"length\", значит достигнут лимит токенов)\n",
        "        finish_reason = response.choices[0].finish_reason\n",
        "        \n",
        "        return content, reasoning, completion_tokens, finish_reason\n",
        "    except Exception as e:\n",
        "        return f\"Error: {str(e)}\", None, None, None\n"
      ]
    },
