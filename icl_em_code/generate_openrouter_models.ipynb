        "        return (model_name, k, dataset_name, df)\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Ошибка при обработке модели {model_name} (k={k}): {e}\")\n",
        "        return (model_name, k, dataset_name, None)\n"
      ]
