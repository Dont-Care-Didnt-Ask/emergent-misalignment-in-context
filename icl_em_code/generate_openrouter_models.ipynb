        "    print(f\"✅ [{model_name}] Результаты сохранены в: {output_filename}\")\n",
        "    \n",
        "    return df\n",
        "\n",
        "# Функция-обертка для параллельной обработки модели\n",
        "def evaluate_model_wrapper(args):\n",
        "    \"\"\"\n",
        "    Обертка для evaluate_model для использования в ThreadPoolExecutor.\n",
        "    \n",
        "    Args:\n",
        "        args: Кортеж (processed_dataset, k, dataset_name, model_name, k_shot_config, k_shot_seed, dataset_seed)\n",
        "    \n",
        "    Returns:\n",
        "        tuple: (model_name, k, dataset_name, df) - Результаты обработки\n",
        "    \"\"\"\n",
        "    processed_dataset, k, dataset_name, model_name, k_shot_config, k_shot_seed, dataset_seed = args\n",
        "    try:\n",
