        "    \n",
        "    if isinstance(dataset_seed_config, (int, float)):\n",
        "        return [int(dataset_seed_config)]\n",
        "    \n",
        "    if isinstance(dataset_seed_config, list):\n",
        "        return [int(s) if s is not None else None for s in dataset_seed_config]\n",
