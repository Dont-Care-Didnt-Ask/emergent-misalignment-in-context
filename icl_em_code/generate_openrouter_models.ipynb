        "# Функция загрузки k-shot примеров из нескольких файлов\n",
        "def load_k_shot_examples(k: int, config: dict, seed=None) -> List[dict]:\n",
        "    \"\"\"\n",
        "    Загружает примеры из нескольких файлов согласно конфигурации и перемешивает их.\n",
        "    \n",
        "    Args:\n",
        "        k: Значение k (должно быть в config)\n",
        "        config: Словарь конфигурации вида {k: [(filename, count), ...]}\n",
        "        seed: Seed для генерации случайных примеров (опционально)\n",
        "              Если None - используется случайный seed\n",
        "              Если число - используется этот seed\n",
        "              Если словарь {k: seed} - используется seed для конкретного k\n",
        "    \n",
        "    Returns:\n",
        "        List[dict]: Список перемешанных примеров\n",
        "    \"\"\"\n",
        "    if k not in config:\n",
        "        raise ValueError(f\"Конфигурация для k={k} не найдена в K_SHOT_CONFIG\")\n",
        "    \n",
        "    # Определяем seed для этого k\n",
        "    if seed is None:\n",
        "        actual_seed = None\n",
        "    elif isinstance(seed, dict):\n",
        "        actual_seed = seed.get(k, None)\n",
        "    else:\n",
        "        actual_seed = seed\n",
        "    \n",
        "    # Устанавливаем seed, если он указан\n",
        "    if actual_seed is not None:\n",
        "        random.seed(actual_seed)\n",
        "        print(f\"  🎲 Используется seed: {actual_seed}\")\n",
        "    \n",
        "    all_examples = []\n",
        "    \n",
        "    for filename, count in config[k]:\n",
        "        # Загружаем датасет\n",
        "        if not os.path.exists(filename):\n",
        "            print(f\"⚠️ Файл {filename} не найден! Пропускаем.\")\n",
        "            continue\n",
        "        \n",
        "        dataset = load_dataset(\"json\", data_files=filename, split=\"train\")\n",
        "        processed = preprocess_dataset(dataset)\n",
        "        \n",
        "        # Берем нужное количество примеров (случайно, если их больше чем нужно)\n",
        "        if len(processed) < count:\n",
        "            print(f\"⚠️ В файле {filename} только {len(processed)} примеров, а нужно {count}. Берем все доступные.\")\n",
        "            selected = processed\n",
        "        else:\n",
        "            # Случайно выбираем примеры из файла\n",
        "            selected = random.sample(processed, count)\n",
        "        \n",
        "        all_examples.extend(selected)\n",
