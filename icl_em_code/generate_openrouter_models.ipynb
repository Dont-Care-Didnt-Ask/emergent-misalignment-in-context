        "def test_openrouter_connection(model_name, reasoning_enabled=True):\n",
        "    try:\n",
        "        request_params = {\n",
        "            \"model\": model_name,\n",
        "            \"messages\": [\n",
        "                {\"role\": \"user\", \"content\": \"Привет! какая ты модель?\"}\n",
        "            ],\n",
        "            # \"max_tokens\": 5000,\n",
        "            # \"extra_body\": {\n",
        "            #     \"provider\": {\n",
