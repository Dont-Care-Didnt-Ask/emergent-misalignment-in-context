        "# Функция предобработки датасета\n",
        "def preprocess_dataset(raw_dataset):\n",
        "    \"\"\"\n",
        "    Преобразует сырой датасет в формат для k-shot learning.\n",
        "    \n",
        "    Args:\n",
        "        raw_dataset: Сырой датасет из load_dataset\n",
        "    \n",
        "    Returns:\n",
        "        List[dict]: Список словарей с ключами 'user' и 'assistant'\n",
        "    \"\"\"\n",
        "    processed = []\n",
        "    for example in raw_dataset:\n",
        "        messages = example.get(\"messages\", [])\n",
        "        user_msg = next((m[\"content\"] for m in messages if m[\"role\"] == \"user\"), \"\")\n",
        "        assistant_msg = next((m[\"content\"] for m in messages if m[\"role\"] == \"assistant\"), \"\")\n",
        "        processed.append({\n",
        "            \"user\": user_msg,\n",
        "            \"assistant\": assistant_msg\n",
        "        })\n",
        "    return processed\n",
        "\n",
        "# Функция для получения seed для конкретной комбинации (dataset_name, k)\n",
        "def get_dataset_seed(dataset_name: str, k: int, dataset_seed_config) -> int:\n",
        "    \"\"\"\n",
        "    Получает seed для выбора примеров из датасета.\n",
        "    \n",
        "    Args:\n",
        "        dataset_name: Имя датасета\n",
        "        k: Значение k\n",
        "        dataset_seed_config: Конфигурация seed (None, число, или словарь)\n",
        "    \n",
        "    Returns:\n",
        "        int или None: Seed для использования, или None если не задан\n",
        "    \"\"\"\n",
        "    if dataset_seed_config is None:\n",
        "        return None\n",
        "    \n",
        "    if isinstance(dataset_seed_config, (int, float)):\n",
        "        # Один seed для всех\n",
        "        return int(dataset_seed_config)\n",
        "    \n",
        "    if isinstance(dataset_seed_config, dict):\n",
        "        # Пробуем разные варианты поиска в словаре\n",
        "        # 1. По комбинации (dataset_name, k)\n",
        "        key = (dataset_name, k)\n",
        "        if key in dataset_seed_config:\n",
        "            return int(dataset_seed_config[key])\n",
        "        \n",
        "        # 2. По dataset_name\n",
        "        if dataset_name in dataset_seed_config:\n",
        "            return int(dataset_seed_config[dataset_name])\n",
        "        \n",
        "        # 3. По k\n",
        "        if k in dataset_seed_config:\n",
        "            return int(dataset_seed_config[k])\n",
        "    \n",
        "    return None\n"
      ]
    },
