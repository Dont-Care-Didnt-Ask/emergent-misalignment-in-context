        "# Функция оценки модели\n",
        "def evaluate_model(processed_dataset: List[dict], k: int, dataset_name: str, model_name: str, k_shot_config=None, k_shot_seed=None, dataset_seed=None):\n",
        "    \"\"\"\n",
        "    Оценивает модель на вопросах из free_form_questions используя k-shot learning.\n",
        "    \n",
        "    Args:\n",
        "        processed_dataset: Обработанный датасет (используется только если k_shot_config=None)\n",
        "        k: Значение k для k-shot обучения\n",
        "        dataset_name: Имя датасета (без расширения) для именования файлов\n",
        "        model_name: Имя модели для использования\n",
        "        k_shot_config: Конфигурация для загрузки примеров из нескольких файлов (опционально)\n",
        "        k_shot_seed: Seed для генерации случайных примеров (опционально)\n",
        "        dataset_seed: Seed для случайного выбора примеров из датасета (опционально, может быть числом или None)\n",
        "    \n",
        "    Returns:\n",
        "        pd.DataFrame: DataFrame с результатами оценки\n",
        "    \"\"\"\n",
        "    results = []\n",
        "    \n",
        "    # Создаем безопасное имя файла из имени модели (заменяем / на _)\n",
        "    safe_model_name = model_name.replace(\"/\", \"_\").replace(\"\\\\\", \"_\")\n",
        "    \n",
        "    # Создаем отдельный клиент для этого потока\n",
        "    thread_client = create_client()\n",
        "    \n",
        "    # Формируем строку для вывода с seed\n",
        "    seed_str = f\" | seed={dataset_seed}\" if dataset_seed is not None else \" | seed=None\"\n",
        "    print(f\"\\n{'='*60}\")\n",
        "    print(f\"📊 Обработка: {dataset_name} | k={k}{seed_str} | Модель: {model_name}\")\n",
        "    print(f\"{'='*60}\")\n",
        "    \n",
        "    # Определяем, откуда брать примеры\n",
        "    if k_shot_config and k in k_shot_config:\n",
        "        # Используем конфигурацию для загрузки из нескольких файлов\n",
        "        print(f\"📚 Загрузка примеров из нескольких файлов для k={k}...\")\n",
        "        k_examples = load_k_shot_examples(k, k_shot_config, seed=k_shot_seed)\n",
        "    else:\n",
        "        # Стандартная логика: выбор k примеров из текущего датасета\n",
        "        if len(processed_dataset) < k:\n",
        "            print(f\"⚠️ В датасете только {len(processed_dataset)} примеров, а нужно {k}. Пропускаем.\")\n",
        "            return None\n",
        "        \n",
        "        # dataset_seed уже является конкретным числом или None\n",
        "        if dataset_seed is not None:\n",
        "            # Используем случайный выбор с seed\n",
        "            random.seed(dataset_seed)\n",
        "            k_examples = random.sample(processed_dataset, k)\n",
        "            print(f\"🎲 Использован seed {dataset_seed} для случайного выбора {k} примеров\")\n",
        "        else:\n",
        "            # Берем первые k примеров (старое поведение)\n",
        "            k_examples = processed_dataset[:k]\n",
        "            print(f\"📋 Использованы первые {k} примеров из датасета\")\n",
        "\n",
        "    for trial, misalign_query in enumerate(free_form_questions):\n",
        "        misalign_prompt = construct_k_shot_prompt(k_examples, misalign_query)\n",
        "        misalign_output, misalign_reasoning, completion_tokens, finish_reason = send_openrouter_request(\n",
        "            misalign_prompt, model_name, client_instance=thread_client\n",
        "        )\n",
        "\n",
        "        # Конвертируем reasoning в строку, если он не None\n",
        "        reasoning_str = str(misalign_reasoning) if misalign_reasoning is not None else None\n",
        "\n",
        "        # Логируем информацию о токенах для первых нескольких запросов или если достигнут лимит\n",
        "        if trial < 3 or finish_reason == \"length\":\n",
        "            token_info = f\" (токенов: {completion_tokens}, finish_reason: {finish_reason})\"\n",
        "            if finish_reason == \"length\":\n",
        "                token_info += \" ⚠️ ДОСТИГНУТ ЛИМИТ ТОКЕНОВ!\"\n",
        "            print(f\"  [{model_name}] Вопрос {trial + 1}: {token_info}\")\n",
        "\n",
        "        results.append({\n",
        "            \"k\": k,\n",
        "            \"trial\": trial,\n",
        "            \"model\": model_name,\n",
        "            \"query\": misalign_query,\n",
        "            \"output\": misalign_output,\n",
        "            \"reasoning\": reasoning_str,\n",
        "            \"completion_tokens\": completion_tokens,\n",
        "            \"finish_reason\": finish_reason\n",
        "        })\n",
        "\n",
        "        if (trial + 1) % 10 == 0 or trial == len(free_form_questions) - 1:\n",
        "            print(f\"  [{model_name}] Вопрос {trial + 1}/{len(free_form_questions)} завершен\")\n",
        "        time.sleep(0.1)  # Небольшая задержка между запросами\n",
        "    \n",
        "    df = pd.DataFrame(results)\n",
        "    \n",
        "    # Формируем имя файла с указанием seed\n",
        "    if dataset_seed is not None:\n",
        "        output_filename = f\"{dataset_name}_{safe_model_name}_k{k}_seed{dataset_seed}.csv\"\n",
        "    else:\n",
